# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3100
API_PREFIX=api

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, zero-config)
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./koda.db
# PostgreSQL (production)
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/koda

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ── Agent API Keys ─────────────────────────────────────────────────────────────
API_KEY_SECRET=change-me-api-key-secret-min-32-chars

# ── Web App (Nuxt) ─────────────────────────────────────────────────────────────
# Internal URL used by Nuxt SSR → API (Docker: service name; bare metal: localhost)
NUXT_API_INTERNAL_URL=http://localhost:3100
# Docker only — override with Docker service name:
# NUXT_API_INTERNAL_URL=http://api:3100
WEB_PORT=3101

# ── VCS Integration ────────────────────────────────────────────────────────────
# Required: 32+ char secret for encrypting VCS tokens at rest
VCS_ENCRYPTION_KEY=change-me-vcs-encryption-key-min-32-chars
# Optional: polling interval in milliseconds (default: 600000 = 10 minutes)
# VCS_DEFAULT_POLLING_INTERVAL_MS=600000
# Optional: override for GitHub Enterprise
# GITHUB_API_URL=https://api.github.com

# ── RAG / Embeddings ───────────────────────────────────────────────────────────
# Embedding provider: ollama (default) | openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Ollama base URL (required when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI API key (required when EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# LanceDB storage path
LANCEDB_PATH=./lancedb
# Full-text search index mode: simple (default) | tantivy
FTS_INDEX_MODE=simple
# FTS optimize strategy: counter (default) | cron | manual
# FTS_OPTIMIZE_STRATEGY=counter
# FTS_OPTIMIZE_THRESHOLD=10
# FTS_OPTIMIZE_INTERVAL_MS=300000
# Similarity thresholds for RAG verdict classification
# SIMILARITY_HIGH=0.85
# SIMILARITY_MEDIUM=0.70
# SIMILARITY_LOW=0.50

# ── API Server ────────────────────────────────────────────────────────────────
# Bind host (default: 0.0.0.0 — rarely needs changing)
# API_HOST=0.0.0.0

# ── Server Security (CORS / Helmet) ────────────────────────────────────────────
SERVER_USE_HELMET=true
SERVER_USE_CORS=true
# Comma-separated list of allowed origins (the web app's public URL)
SERVER_CORS_ORIGIN=http://localhost:3101
SERVER_CORS_CREDENTIALS=true

# ── CLI ────────────────────────────────────────────────────────────────────────
# These vars are used by the koda CLI (apps/cli). Set them in your shell or
# a project-local .env; they are NOT read by the API server.
# KODA_API_URL=http://localhost:3100
# KODA_API_KEY=your-agent-api-key
# KODA_PROJECT_SLUG=my-project
