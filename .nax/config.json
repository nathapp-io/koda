{
    "name": "koda",
    "version": 1,
    "quality": {
        "commands": {
            "test": "npx turbo test",
            "testScoped": "npx turbo test --filter=[HEAD^1]",
            "typecheck": "bunx turbo type-check",
            "lint": "bunx turbo lint",
            "lintFix": "bunx turbo lint:fix",
            "formatFix": "bunx turbo lint:fix"
        }
    },
    "review": {
        "enabled": true,
        "checks": ["build", "typecheck", "lint", "semantic", "adversarial"],
        "commands": {
            "build": "bun run build",
            "typecheck": "bunx turbo type-check",
            "lint": "bunx turbo lint",
            "lintFix": "bunx turbo lint:fix"
        }
    },
    "precheck": {
        "storySizeGate": {
            "enabled": true,
            "maxAcCount": 15,
            "maxBulletPoints": 15
        }
    },
    "execution": {
        "smartTestRunner": {
            "testFilePatterns": ["**/*.spec.ts"]
        },
        "sandbox": {
            "network": {
                "allowLocalBinding": true
            }
        }
    },
    "mcp": {
        "servers": {
            "codebase-memory": {
                "command": "codebase-memory-mcp",
                "stages": ["run", "review"],
                "allowedTools": [
                    "search_graph",
                    "query_graph",
                    "trace_path",
                    "get_code_snippet",
                    "get_architecture",
                    "search_code",
                    "detect_changes",
                    "list_projects",
                    "check_index_coverage",
                    "get_file_outline"
                ]
            }
        }
    }
}
