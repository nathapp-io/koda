{
  "project": {
    "language": "typescript",
    "testFramework": "vitest"
  },
  "quality": {
    "commands": {
      "build": "bun run build:generate",
      "test": "bun run test",
      "testScoped": "bun run test:scoped {{files}}",
      "typecheck": "bun run type-check",
      "lint": "bun run lint:report"
    }
  },
  "execution": {
    "smartTestRunner": {
      "testFilePatterns": [
        "**/__tests__/**/*.js",
        "**/__tests__/**/*.jsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/spec.js",
        "**/spec.jsx",
        "**/spec.ts",
        "**/spec.tsx",
        "**/test.js",
        "**/test.jsx",
        "**/test.ts",
        "**/test.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ]
    }
  }
}
