# Application
NODE_ENV=development
API_PORT=3100
GLOBAL_PREFIX=api

# Database
DATABASE_URL=postgresql://koda:koda@localhost:5432/koda

# JWT Auth
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# Agent API Key
API_KEY_SECRET=your-api-key-secret-here

# Outbox
# Relay toggle; defaults to on outside tests (see src/config/outbox.config.ts)
OUTBOX_RELAY_ENABLED=true
# Terminal (published/dead) outbox rows older than this many days are purged nightly at 04:00.
# Default 30; 0 disables the purge.
OUTBOX_RETENTION_DAYS=30

# Self-registration after the first (bootstrap ADMIN) user. Default false:
# a global ADMIN creates users under /admin/users. Accepts only true|false.
REGISTRATION_ENABLED=false
