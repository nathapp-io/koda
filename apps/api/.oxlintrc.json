{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "es2022": true,
    "vitest": true
  },
  "ignorePatterns": ["dist/", "node_modules/", ".turbo/", "coverage/", "src/generated/", "test/src/"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/explicit-module-boundary-types": "off",
    "no-unused-vars": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@prisma/client",
            "message": "Import from the generated client (src/generated/prisma/client) instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-require-imports": "off"
      }
    },
    {
      "files": ["test/integration/rag/entity-store.integration.spec.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
