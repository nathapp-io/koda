#!/bin/bash
# Recording `docker` stub for apps/api/test/unit/tooling/helpers/deploy-script-harness.ts.
#
# Every call appends one record to $KODA_DEPLOY_HARNESS_RECORD: the argument count, then KODA_VERSION as
# the child saw it, then the arguments, each field NUL-terminated; the harness parses that file.
#
# Before deciding the exit code, the stub writes the files a real container would leave on the host: a
# `tar -czf /backup/<name>` call writes <name> under $KODA_DEPLOY_HARNESS_DIR/backups, and a pg_dump call
# writes $KODA_DEPLOY_HARNESS_PG_DUMP. Both happen even for a call that fails, so a script that writes an
# archive straight to its restore-ready name leaves a partial file a test can catch (review B9).
#
# The call then fails (exit 1) when its argv, joined with spaces and with every occurrence of the per-test
# temp dir removed, contains one of the $KODA_DEPLOY_HARNESS_FAIL_ON lines. A pg_dump call exits with
# $KODA_DEPLOY_HARNESS_PG_DUMP_EXIT.
#
# A `compose run … -c <script> <arg>…` call that passes positional arguments is a restore pipeline, and the
# stub really runs it on the host: `/data` is bound to the fake volume $KODA_DEPLOY_HARNESS_VOLUME and
# `/backup` to the host directory the call mounts, with the trailing arguments as the command's `$@`, exactly
# like `docker compose run … api -c '<script>' koda-restore <archive>`. A test can then assert the files a
# restore leaves in the volume, not only the arguments it passed (review B12, B13). The call exits with the
# command's own status. Every other call succeeds silently (the pg_dump and archive cases below decide first).
#
# It must stay bash 3.2 portable: macOS /bin/bash runs it in the suite.

{
  printf '%s\0' "$#"
  printf '%s\0' "${KODA_VERSION-}"
  for argument in "$@"; do
    printf '%s\0' "$argument"
  done
} >> "$KODA_DEPLOY_HARNESS_RECORD"

for argument in "$@"; do
  case "$argument" in
    "tar -czf /backup/"*)
      archive="${argument#tar -czf /backup/}"
      archive="${archive%% *}"
      mkdir -p "$KODA_DEPLOY_HARNESS_DIR/backups"
      printf 'partial data volume archive\n' > "$KODA_DEPLOY_HARNESS_DIR/backups/$archive"
      ;;
  esac
done

joined=""
for argument in "$@"; do
  joined="$joined $argument"
done

# Drop the temp dir first, so a random directory suffix never matches a failOn entry by accident.
joined="${joined//"$KODA_DEPLOY_HARNESS_DIR"/}"

while IFS= read -r pattern; do
  if [[ -z "$pattern" ]]; then
    continue
  fi
  case "$joined" in
    *"$pattern"*)
      exit 1
      ;;
  esac
done <<< "${KODA_DEPLOY_HARNESS_FAIL_ON-}"

case "$joined" in
  *pg_dump*)
    if [[ -n "${KODA_DEPLOY_HARNESS_PG_DUMP-}" ]]; then
      cat "$KODA_DEPLOY_HARNESS_PG_DUMP"
    fi
    exit "${KODA_DEPLOY_HARNESS_PG_DUMP_EXIT:-0}"
    ;;
esac

# Model Compose's rendered config for the fixtures (not a general dotenv parser).
case "$1" in
  create)
    mkdir "$KODA_DEPLOY_HARNESS_DIR/.harness/$3" || exit 1
    printf '%s\n' "$3"
    exit 0
    ;;
  rm)
    rmdir "$KODA_DEPLOY_HARNESS_DIR/.harness/$2"
    exit "$?"
    ;;
esac
if [[ "$joined" == *' config' ]]; then
  project="${COMPOSE_PROJECT_NAME:-}"
  if [[ -z "$project" && -f "$KODA_DEPLOY_HARNESS_DIR/.env" ]]; then
    project="$(grep '^COMPOSE_PROJECT_NAME=' "$KODA_DEPLOY_HARNESS_DIR/.env" | cut -d= -f2-)"
  fi
  project="${project:-koda-local}"
  version="${KODA_VERSION:-}"
  if [[ -z "$version" && -f "$KODA_DEPLOY_HARNESS_DIR/.env" ]]; then
    version="$(grep '^KODA_VERSION=' "$KODA_DEPLOY_HARNESS_DIR/.env" | cut -d= -f2- | tail -n 1)"
  fi
  project="${project//'${PROJECT_SUFFIX}'/${version:-default}}"
  project="${project//'${KODA_VERSION}'/${version:-latest}}"
  if [[ ! "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then exit 1; fi
  printf 'name: %s\nservices:\n  api:\n    image: nathapp/koda-api:%s\n    volumes:\n      - type: volume\n        source: koda_data\n        target: /data\nvolumes:\n  koda_data:\n    name: %s\n' \
    "$project" "${version:-latest}" "${KODA_DEPLOY_HARNESS_VOLUME_NAME:-${project}_koda_data}"
  exit 0
fi

# Restore pipeline: `run … -c <script> <positional args…>`.
args=( "$@" )
command_index=-1
mount_spec=""
index=0
while [[ "$index" -lt "${#args[@]}" ]]; do
  case "${args[$index]}" in
    -v)
      index=$((index + 1))
      mount_spec="${args[$index]-}"
      ;;
    -c)
      index=$((index + 1))
      command_index=$index
      ;;
  esac
  index=$((index + 1))
done

if [[ "$command_index" -ge 0 && "$command_index" -lt "$(( ${#args[@]} - 1 ))" ]]; then
  command="${args[$command_index]}"
  volume="${KODA_DEPLOY_HARNESS_VOLUME:?the harness must set KODA_DEPLOY_HARNESS_VOLUME}"
  positional=( "${args[@]:$((command_index + 1))}" )
  # Bind the container paths to the host directories, and run the command with the trailing arguments as
  # its `$@`, so `$1` is what the archive argument was.
  if [[ -n "$mount_spec" ]]; then
    mount_source="${mount_spec%%:*}"
    translated="$(printf '%s' "$command" | sed -e "s#/backup#$mount_source#g" -e "s#/data#$volume#g")"
  else
    translated="$(printf '%s' "$command" | sed -e "s#/data#$volume#g")"
  fi
  helpers='stat() {
    if [ "$(uname -s)" = Darwin ] && [ "$1" = "-c" ] && [ "$2" = "%u:%g %a" ]; then
      command stat -f "%u:%g %Lp" "$3"
    else
      command stat "$@"
    fi
  }
  mv() {
    case "$2" in
      */.koda-restore-previous/entries/|*/.koda-restore-previous/) phase=save ;;
      "$KODA_DEPLOY_HARNESS_VOLUME"/) phase=install ;;
      *) command mv "$@"; return ;;
    esac
    if [ "${KODA_DEPLOY_HARNESS_FAIL_MOVE-}" = "$phase" ] && [ "${1##*/}" = z ]; then return 1; fi
    command mv "$@" || return
    if [ "$phase" = install ] && [ -n "${KODA_DEPLOY_HARNESS_COMPETE-}" ]; then
      # Re-enter while the winner owns staging and has already installed its first entry.
      set +e
      KODA_DEPLOY_HARNESS_COMPETE= COMPOSE_PROJECT_NAME=koda-other /bin/bash "$KODA_DEPLOY_HARNESS_DIR/rollback.sh" v0.4.1 --restore-db "$KODA_DEPLOY_HARNESS_COMPETE"
      contender_status=$?
      set -e
      printf "Contender exit: %s\n" "$contender_status"
      unset KODA_DEPLOY_HARNESS_COMPETE
    fi
  }'
  ( cd "${KODA_DEPLOY_HARNESS_DIR:?}" && /bin/sh -c "$helpers
$translated" "${positional[@]}" )
  exit "$?"
fi

exit 0
