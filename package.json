{
  "name": "koda",
  "version": "0.4.2",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:reset": "turbo run db:reset",
    "api:export-spec": "bash -c 'cd apps/api && bun run build && bun scripts/export-spec.cjs'",
    "generate:cli": "openapi-ts",
    "generate": "bun run api:export-spec && bun run generate:cli",
    "generate:spec": "bun run api:export-spec"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "marked": "^17.0.5"
  },
  "engines": {
    "node": ">=22.22.3",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5",
    "simple-git": "^4.0.2",
    "@hey-api/json-schema-ref-parser>js-yaml": "^4.3.2",
    "@eslint/config-inspector>esbuild": "^0.28.1",
    "postcss-selector-parser": "^7.1.7",
    "vue": "^3.5.44"
  }
}
